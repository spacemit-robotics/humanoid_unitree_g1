cmake_minimum_required(VERSION 3.16)

# The SDK includes this file when configuring G1. The navigation board runs it
# with cmake -P instead: no compiler, ROS environment or G1 build is needed.
function(g1_prepare_mediamtx)
    set(version 1.15.5)
    if(CMAKE_SCRIPT_MODE_FILE)
        set(system "${CMAKE_HOST_SYSTEM_NAME}")
        cmake_host_system_information(RESULT arch QUERY OS_PLATFORM)
    else()
        set(system "${CMAKE_SYSTEM_NAME}")
        set(arch "${CMAKE_SYSTEM_PROCESSOR}")
    endif()
    if(system STREQUAL "Linux" AND arch MATCHES "^(x86_64|amd64|AMD64)$")
        set(arch amd64)
        set(base "https://github.com/bluenviron/mediamtx/releases/download/v${version}")
        set(digest 158ebff59739d723a5bb60a7c6c42d908d378609f6237a94e583edd5456f7322)
    elseif(system STREQUAL "Linux" AND arch STREQUAL "riscv64")
        set(base "https://archive.spacemit.com/ros2/prebuilt_libs/bianbu26/opt/ext/mediamtx")
        set(digest d2d3c9ac134a86c1dc7326c0e738cbbdfa9640a358000c6383a8e84e2847bc95)
    else()
        set(missing "no prebuilt package for ${system}/${arch}" PARENT_SCOPE)
        return()
    endif()

    set(cache_root "$ENV{SROBOTIS_THIRDPARTY_CACHE}")
    if(NOT cache_root)
        set(cache_root "$ENV{HOME}/.cache/thirdparty")
    endif()
    set(dir "${cache_root}/mediamtx/${version}/${arch}")
    set(name "mediamtx_v${version}_linux_${arch}.tar.gz")
    set(package "${dir}/${name}")
    file(MAKE_DIRECTORY "${dir}")
    file(LOCK "${dir}/fetch.lock" GUARD FUNCTION TIMEOUT 60)
    if(NOT EXISTS "${package}")
        if(SROBOTIS_THIRDPARTY_FETCH_OFF)
            set(missing "offline and ${package} is not cached" PARENT_SCOPE)
            return()
        endif()
        message(STATUS "Fetching ${name}")
        file(DOWNLOAD "${base}/${name}" "${package}.part" TLS_VERIFY ON
             TIMEOUT 45 INACTIVITY_TIMEOUT 12 STATUS result)
        list(GET result 0 code)
        if(NOT code EQUAL 0)
            file(REMOVE "${package}.part")
            set(missing "${base}/${name}: ${result}" PARENT_SCOPE)
            return()
        endif()
        file(SHA256 "${package}.part" actual)
        if(NOT actual STREQUAL digest)
            file(REMOVE "${package}.part")
            message(FATAL_ERROR "MediaMTX download checksum mismatch: ${name}")
        endif()
        file(RENAME "${package}.part" "${package}")
    endif()
    file(SHA256 "${package}" actual)
    if(NOT actual STREQUAL digest)
        message(FATAL_ERROR "MediaMTX cache checksum mismatch: ${package}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xzf "${package}" -- mediamtx LICENSE
                    WORKING_DIRECTORY "${dir}" RESULT_VARIABLE code)
    if(NOT code EQUAL 0)
        message(FATAL_ERROR "Cannot unpack ${package}")
    endif()
    set(mediamtx_dir "${dir}" PARENT_SCOPE)
endfunction()

unset(missing)
g1_prepare_mediamtx()
if(missing)
    if(CMAKE_SCRIPT_MODE_FILE)
        message(FATAL_ERROR "MediaMTX: ${missing}")
    endif()
    message(WARNING "Skipping optional MediaMTX web preview gateway: ${missing}")
elseif(CMAKE_SCRIPT_MODE_FILE)
    if(NOT IS_ABSOLUTE "${CMAKE_INSTALL_PREFIX}")
        message(FATAL_ERROR "Pass -DCMAKE_INSTALL_PREFIX=<absolute installation prefix>")
    endif()
    file(INSTALL "${mediamtx_dir}/mediamtx" DESTINATION "${CMAKE_INSTALL_PREFIX}/bin" TYPE PROGRAM)
    file(INSTALL "${mediamtx_dir}/LICENSE" DESTINATION "${CMAKE_INSTALL_PREFIX}/share/licenses/mediamtx")
else()
    install(PROGRAMS "${mediamtx_dir}/mediamtx" DESTINATION bin)
    install(FILES "${mediamtx_dir}/LICENSE" DESTINATION share/licenses/mediamtx)
endif()
